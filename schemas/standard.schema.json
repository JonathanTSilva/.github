{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub standard",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "author", "contact_email", "plan", "name_pattern", "special_names", "kinds", "statuses", "profiles", "licenses"],
  "properties": {
    "version": { "const": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "contact_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "plan": { "enum": ["free", "pro", "team", "enterprise"] },
    "name_pattern": { "type": "string", "minLength": 1 },
    "special_names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prefix", "suffix", "emoji", "topic"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "prefix": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-$" },
          "suffix": { "type": ["string", "null"], "pattern": "^-[a-z0-9]+(-[a-z0-9]+)*$" },
          "emoji": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "pattern": "^kind-[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "statuses": {
      "type": "array",
      "items": { "enum": ["concept", "wip", "active", "inactive", "unsupported", "archived"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "archived", "exempt", "special"],
      "properties": {
        "active": { "$ref": "#/definitions/profile" },
        "archived": { "$ref": "#/definitions/profile" },
        "exempt": { "$ref": "#/definitions/profile" },
        "special": { "$ref": "#/definitions/profile" }
      }
    },
    "licenses": {
      "type": "array",
      "items": { "enum": ["mit", "cc-by-4.0", "mit+cc-by-4.0", "proprietary", "agpl-3.0", "company"] },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "definitions": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_files"],
      "properties": {
        "required_files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
